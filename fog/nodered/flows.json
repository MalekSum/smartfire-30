    {
        "id": "fe53dedb2c78ef8e",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "découpe mesure",
        "func": "// msg.payload est déjà un objet JSON (on l'a demandé dans le nœud mqtt in)\nconst d = msg.payload;\n\n// valid = 0 veut dire qu'un capteur est hors plage ou figé (contrat, section 4).\n// On n'affiche pas ces valeurs douteuses sur les courbes.\nif (d.valid === 0) {\n    return null;\n}\n\n// Un tableau de 3 messages = un message par sortie (sortie 1, 2, 3)\nreturn [\n    { payload: d.t },\n    { payload: d.h },\n    { payload: d.gaz }\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
