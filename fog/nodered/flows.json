    {
        "id": "e64fc8562c550ef7",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "état des couches",
        "func": "// topic = m2i2a/equipe30/<couche>/statut  ->  la couche est le 3e morceau\nconst layer = msg.topic.split('/')[2];\n\n// On garde l'état des deux couches en mémoire (contexte du flow)\nconst st = flow.get('layers') || { edge: 'inconnu', fog: 'inconnu' };\nst[layer] = String(msg.payload).trim();\nflow.set('layers', st);\n\nmsg.payload = st;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
