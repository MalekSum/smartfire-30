        "name": "vider compteurs et versions",
        "func": "// Le Cloud ne répond pas : on envoie un objet vide au template concerné, qui affiche '—'\n// msg.error.source.id = identifiant du nœud http request qui a échoué\nconst src = (msg.error && msg.error.source) ? msg.error.source.id : '';\nconst vide = { payload: {} };\nif (src === 'f779a61d06f6ffbf') { return [vide, null]; }   // GET /api/stats -> compteurs\nif (src === 'de060d3cd16606f3') { return [null, vide]; }   // GET /api/modele/version -> versions\nreturn null;",
