    {
        "id": "sf_al_fn",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "journal des alertes",
        "func": "// msg.payload = {\"id\",\"seq\",\"ts\",\"niveau\",\"source\"} (topic edge/alerte, contrat)\nconst a = msg.payload;\n\n// On garde les 10 dernières alertes dans le contexte du flow (mémoire de Node-RED)\nconst liste = flow.get('alertes') || [];\n\n// On stocke l'heure d'ARRIVÉE en millisecondes (Date.now()).\n// Le formatage HH:mm:ss est fait dans le template, côté navigateur (bon fuseau horaire).\nliste.unshift({ t: Date.now(), id: a.id, seq: a.seq, niveau: a.niveau, source: a.source });\n\n// On coupe à 10 éléments : la plus récente est en haut\nif (liste.length > 10) { liste.length = 10; }\n\nflow.set('alertes', liste);\nmsg.payload = liste;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1480,
        "y": 960,
        "wires": [
            [
                "sf_al_tpl"
            ]
        ]
    },
