        "z": "f6f2187d.f17ca8",
        "group": "sf_grp_alert",
        "name": "liste des alertes",
        "order": 0,
        "width": 0,
        "height": 0,
        "format": "<div style=\"font-size:15px\">\n  <div ng-if=\"!msg.payload.length\">Aucune alerte reçue</div>\n  <table style=\"width:100%; border-spacing:0 4px;\">\n    <tr ng-repeat=\"a in msg.payload\">\n      <td>{{a.t | date:'HH:mm:ss'}}</td>\n      <td>nœud {{a.id}}</td>\n      <td>seq {{a.seq}}</td>\n      <td style=\"color:#c62828\"><b>niveau {{a.niveau}} ({{a.source}})</b></td>\n    </tr>\n  </table>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
