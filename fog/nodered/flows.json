    {
        "id": "5bf9f09d3637d442",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "choix de la couleur",
        "func": "// Entrée : message du topic fog/resultats (contrat, section 5)\nconst d = msg.payload;\n\n// Qui décide ? En S3 c'est l'Edge (le Fog relaie seulement), sinon c'est le Fog (ou le Cloud en S1, republié par le Fog).\nconst y = (d.mode === 'S3') ? d.y_edge : d.y_fog;\n\n// -1 ou absent = pas de décision (mesure invalide, Cloud coupé en S1...) : on n'affiche rien\nif (y === undefined || y < 0) { return null; }\n\n// Les 3 classes du contrat : 0 normal, 1 perturbation, 2 incendie\nconst classes = {\n    0: { label: 'NORMAL',       color: '#2e7d32' },  // vert\n    1: { label: 'PERTURBATION', color: '#ef6c00' },  // orange\n    2: { label: 'INCENDIE',     color: '#c62828' }   // rouge\n};\nif (!classes[y]) { return null; }\n\nconst nom = (v) => v === 2 ? 'incendie' : v === 1 ? 'perturbation' : v === 0 ? 'normal' : 'non calculé';\n\nmsg.label  = classes[y].label;\nmsg.color  = classes[y].color;\nmsg.mode   = d.mode;\nmsg.detail = 'Edge : ' + nom(d.y_edge) + '  ·  Fog : ' + nom(d.y_fog);\n\n// En S4 seulement, le Fog confirme ou infirme l'alarme de l'Edge (champ confirme, contrat section 2)\nmsg.note = (d.mode === 'S4' && d.y_edge === 2) ? (d.confirme ? 'Alarme confirmée par le Fog' : 'Fausse alarme évitée (Fog non confirmé)') : '';\n\n// Heure d'arrivée (ms) : formatée côté navigateur dans le template\nmsg.time = Date.now();\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1610,
        "y": 160,
        "wires": [
            [
                "d153e791d2123272"
            ]
        ]
    },
    {
        "id": "d153e791d2123272",
        "type": "ui_template",
        "z": "f6f2187d.f17ca8",
        "group": "b33e8ad3800c30eb",
        "name": "bloc décision",
        "order": 0,
        "width": "6",
        "height": "3",
        "format": "<div ng-if=\"!msg.label\" style=\"text-align:center; padding:26px 10px; border-radius:12px; background:#9e9e9e; color:white; font-size:20px;\">\n  En attente d'une décision…\n</div>\n<div ng-if=\"msg.label\" ng-style=\"{'background-color': msg.color}\"\n     style=\"text-align:center; padding:20px 10px; border-radius:12px; color:white; box-shadow:0 2px 6px rgba(0,0,0,.25);\">\n  <div style=\"font-size:32px; font-weight:bold; letter-spacing:1px;\">{{msg.label}}</div>\n  <div style=\"font-size:15px; margin-top:6px;\">Scénario {{msg.mode}}  ·  {{msg.detail}}</div>\n  <div ng-if=\"msg.note\" style=\"font-size:14px; margin-top:4px; font-weight:bold;\">{{msg.note}}</div>\n  <div style=\"font-size:12px; margin-top:6px; opacity:.85;\">Dernière décision à {{msg.time | date:'HH:mm:ss'}}</div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 1850,
        "y": 140,
        "wires": [
            []
        ]
    },
