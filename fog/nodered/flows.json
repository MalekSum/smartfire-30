        "format": "<table style=\"width:100%; font-size:18px; border-spacing:0 8px;\">\n  <tr><td>Mesures reçues</td><td style=\"text-align:right\"><b>{{msg.payload.total !== undefined ? msg.payload.total : '—'}}</b></td></tr>\n  <tr><td>Alertes incendie</td><td style=\"text-align:right\"><b>{{msg.payload.alertes !== undefined ? msg.payload.alertes : '—'}}</b></td></tr>\n  <tr><td>Fausses alarmes évitées</td><td style=\"text-align:right\"><b>{{msg.payload.fausses_alarmes_evitees !== undefined ? msg.payload.fausses_alarmes_evitees : '—'}}</b></td></tr>\n  <tr><td>Désaccords Edge/Fog</td><td style=\"text-align:right\"><b>{{msg.payload.desaccords_edge_fog !== undefined ? msg.payload.desaccords_edge_fog : '—'}}</b></td></tr>\n  <tr><td>Dernière réception</td><td style=\"text-align:right\">\n    <span ng-if=\"msg.payload.derniere_reception\">{{msg.payload.derniere_reception * 1000 | date:'HH:mm:ss'}}</span>\n    <span ng-if=\"!msg.payload.derniere_reception\">—</span></td></tr>\n</table>",
